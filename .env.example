# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# Path to your customer export (HubSpot companies CSV or the example)
CUSTOMERS_CSV=examples/customers.example.csv
SINCE_DAYS=30
MIN_POSTS=2

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
